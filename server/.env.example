# ==================================================
# SERVER
# ==================================================
PORT=5000
NODE_ENV=development

# ==================================================
# DATABASE
# ==================================================
MONGODB_URI=your_mongodb_uri
MONGODB_URI_PROD=your_mongodb_prod_uri
#your_mongodb_uri

# ==================================================
# REDIS
# ==================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================================================
# JWT AUTHENTICATION
# ==================================================
JWT_SECRET=your_jwt_secret
JWT_EXPIRY=30d
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# ==================================================
# TWILIO (SMS OTP)
# ==================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ==================================================
# GOOGLE MAPS
# ==================================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ==================================================
# STRIPE PAYMENT
# ==================================================
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=noreply@raftar.com
EMAIL_REPLY_TO=support@raftar.com


# ==================================================
# EASYPAISA PAYMENT
# ==================================================
# EASYPAISA_MERCHANT_ID=your_merchant_id
# EASYPAISA_PASSWORD=your_password
# EASYPAISA_IPG_URL=https://easypaisa.com/ipg

# ==================================================
# JAZZCASH PAYMENT
# ==================================================
# JAZZCASH_MERCHANT_ID=your_merchant_id
# JAZZCASH_PASSWORD=your_password
# JAZZCASH_IPG_URL=https://jazzcash.com/ipg

# ==================================================
# RAAST PAYMENT
# ==================================================
# RAAST_API_URL=https://raast.com/api
# RAAST_API_KEY=your_raast_api_key

# ==================================================
# FILE UPLOAD
# ==================================================
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# ==================================================
# SOCKET.IO
# ==================================================
SOCKET_PORT=5001
CORS_ORIGIN=*

# ==================================================
# LOGGING
# ==================================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ==================================================
# SECURITY
# ==================================================
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100